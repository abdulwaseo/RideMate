# RideMate Backend Environment Configurations

APP_NAME="RideMate API"
APP_ENV="development"
DEBUG=True

# Security settings (Change SECRET_KEY in production)
SECRET_KEY="supersecretkeythatisextremelyhardtoguessandsecure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL)
# For local development: postgresql://postgres:postgres@localhost:5432/ridemate
# For docker-compose: postgresql://postgres:postgres@db:5432/ridemate
DATABASE_URL="postgresql://postgres:postgres@db:5432/ridemate"

# CORS configuration (comma separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000"

# Logging levels (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

# File Upload Directory path
UPLOAD_DIRECTORY="uploads"
